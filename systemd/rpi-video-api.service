[Unit]
Description=Raspberry Pi Video Gateway FastAPI
After=network.target

[Service]
Type=simple
User=kai

WorkingDirectory=/home/kai/projects/rpi_video_gateway/python

EnvironmentFile=/home/kai/projects/rpi_video_gateway/config/api-auth.env

ExecStart=/home/kai/projects/rpi_video_gateway/python/.venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000

Restart=on-failure
RestartSec=3

KillSignal=SIGTERM
TimeoutStopSec=10

UMask=0077

StandardOutput=journal
StandardError=journal
SyslogIdentifier=rpi-video-api

[Install]
WantedBy=multi-user.target